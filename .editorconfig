# EditorConfig — consistent whitespace across editors. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# C++ sources, Qt stylesheets/resources, SQL, CMake — all 4-space.
[*.{cpp,cc,cxx,h,hpp,qss,qrc,sql,cmake}]
indent_style = space
indent_size = 4

[CMakeLists.txt]
indent_style = space
indent_size = 4

# Data/config files conventionally use 2-space.
[*.{yml,yaml,json,md}]
indent_size = 2

# Don't impose rules on generated dumps.
[medicines_export.csv]
trim_trailing_whitespace = false
insert_final_newline = false
