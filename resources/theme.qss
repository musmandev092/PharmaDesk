/*
 * PharmaDesk — app-wide Qt Style Sheet (LIGHT theme).
 * Professional enterprise look: slate neutrals + teal accent.
 * Single source of truth for the desktop look; keep colors here, not scattered
 * in widget code. QSS is a CSS subset — supports color, font, padding,
 * border-radius, :hover / :pressed / :focus.
 *
 * LIGHT tokens:
 *   app-bg          #f5f7fa   card           #ffffff
 *   border          #e3e8ee   border-subtle  #eef1f5
 *   text            #0f172a   muted          #64748b
 *   primary         #0d9488   primary-hover  #0f766e
 *   primary-pressed #0b5e54   primary-soft   #e6f6f4   primary-fg #ffffff
 *   secondary-bg    #eef2f7   secondary-fg   #334155
 *   danger          #e02424   warning        #d97706   success    #15a34a
 *   row-hover       #f4f7fa   selection      #cfeeea
 *   header-bg       #f7f9fb   gridline       #eef1f5
 *
 *   radii: card 10  control 8  small 6
 *   type:  base 13px  #h1 22/700  #h2 16/700  #muted 12px
 */

QWidget {
    background-color: #f5f7fa;
    color: #0f172a;
    font-family: "Inter", "Segoe UI", "Roboto", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog { background-color: #f5f7fa; }

/* Labels/checkboxes/radios must NOT paint the page background, or they show as
   gray boxes on white cards and tables. Keep them transparent. */
QLabel, QCheckBox, QRadioButton { background: transparent; }

/* ── Headings / text helpers (set via objectName) ───────────────────────── */
QLabel#h1 { font-size: 22px; font-weight: 700; color: #0f172a; }
QLabel#h2 { font-size: 16px; font-weight: 700; color: #0f172a; }
QLabel#muted { color: #64748b; font-size: 12px; }

/* ── Card surface (objectName "card") ───────────────────────────────────── */
QFrame#card {
    background-color: #ffffff;
    border: 1px solid #e3e8ee;
    border-radius: 10px;
    padding: 20px;
}

/* ── Group boxes ─────────────────────────────────────────────────────────
   Bordered section with an #h2-like title sitting on the top border. */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #e3e8ee;
    border-radius: 10px;
    margin-top: 14px;
    padding: 16px;
    padding-top: 20px;
    font-size: 16px;
    font-weight: 700;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 16px;
    top: 2px;
    padding: 0 4px;
    color: #0f172a;
    font-size: 16px;
    font-weight: 700;
}

/* ── Form layouts: breathing room between rows / labels. ─────────────────── */
QFormLayout { spacing: 10px; }
QLabel#fieldLabel { color: #334155; font-weight: 600; }

/* ── Buttons ─────────────────────────────────────────────────────────────
   Default = primary. Variants via property: setProperty("variant","secondary"
   |"destructive"|"ghost"). */
QPushButton {
    background-color: #0d9488;
    color: #ffffff;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 600;
    min-height: 16px;
}
QPushButton:hover { background-color: #0f766e; }
QPushButton:pressed { background-color: #0b5e54; }
QPushButton:focus { outline: none; border: 1px solid #0b5e54; }
QPushButton:disabled { color: #ffffff; background-color: #9fd4cd; border-color: transparent; }

QPushButton[variant="secondary"] {
    background-color: #eef2f7;
    color: #334155;
    border: 1px solid #e3e8ee;
}
QPushButton[variant="secondary"]:hover { background-color: #e4eaf1; border-color: #d4dce6; }
QPushButton[variant="secondary"]:pressed { background-color: #dae1ea; }
QPushButton[variant="secondary"]:focus { border: 1px solid #0d9488; }
QPushButton[variant="secondary"]:disabled { color: #94a3b8; background-color: #eef2f7; }

QPushButton[variant="destructive"] { background-color: #e02424; color: #ffffff; border: 1px solid transparent; }
QPushButton[variant="destructive"]:hover { background-color: #c81f1f; }
QPushButton[variant="destructive"]:pressed { background-color: #ad1b1b; }
QPushButton[variant="destructive"]:focus { border: 1px solid #ad1b1b; }
QPushButton[variant="destructive"]:disabled { background-color: #f0a3a3; color: #ffffff; }

QPushButton[variant="ghost"] { background-color: transparent; color: #0f172a; border: 1px solid transparent; }
QPushButton[variant="ghost"]:hover { background-color: #eef2f7; }
QPushButton[variant="ghost"]:pressed { background-color: #e4eaf1; }
QPushButton[variant="ghost"]:focus { border: 1px solid #e3e8ee; }
QPushButton[variant="ghost"]:disabled { color: #94a3b8; background-color: transparent; }

/* ── Inputs ─────────────────────────────────────────────────────────────── */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QPlainTextEdit, QTextEdit {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #e3e8ee;
    border-radius: 8px;
    padding: 5px 9px;
    min-height: 18px;
    selection-background-color: #0d9488;
    selection-color: #ffffff;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover,
QDateEdit:hover, QPlainTextEdit:hover, QTextEdit:hover {
    border: 1px solid #c8d2de;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QDateEdit:focus, QPlainTextEdit:focus, QTextEdit:focus {
    border: 1px solid #0d9488;
}
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled,
QDateEdit:disabled, QPlainTextEdit:disabled, QTextEdit:disabled {
    background-color: #eef2f7; color: #94a3b8;
}
/* Extra right padding so the spinbox steppers don't crowd the value. */
QSpinBox, QDoubleSpinBox { padding-right: 20px; }

/* ── Checkboxes / radios ────────────────────────────────────────────────────
   Default Qt indicators render invisible against the card surface; draw an
   explicit bordered box. :checked = filled primary box (no image needed). */
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #e3e8ee;
    background-color: #ffffff;
}
QCheckBox::indicator { border-radius: 4px; }
QRadioButton::indicator { border-radius: 9px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border: 1px solid #0d9488; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #0d9488;
    border: 1px solid #0d9488;
}
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    background-color: #eef2f7; border: 1px solid #e3e8ee;
}

/* ── Spinbox steppers ───────────────────────────────────────────────────────
   Give the up/down buttons real width/position so native arrows aren't clipped.
   Don't override the arrow images — let Qt draw them. */
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 16px;
    border-left: 1px solid #e3e8ee;
    background-color: #eef2f7;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 16px;
    border-left: 1px solid #e3e8ee;
    background-color: #eef2f7;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #e4eaf1;
}

/* ── Tables (QSqlTableModel → QTableView list screens) ──────────────────── */
QTableView {
    background-color: #ffffff;
    alternate-background-color: #f7f9fb;
    border: 1px solid #e3e8ee;
    border-radius: 10px;
    gridline-color: #eef1f5;
    selection-background-color: #cfeeea;
    selection-color: #0f172a;
}
QTableView::item { padding: 8px 10px; border: none; }
QTableView::item:selected { background-color: #cfeeea; color: #0f172a; }
QTableView::item:hover { background-color: #f4f7fa; }
QHeaderView { background-color: #f7f9fb; }
QHeaderView::section {
    background-color: #f7f9fb;
    color: #64748b;
    padding: 8px 10px;
    border: none;
    border-bottom: 1px solid #e3e8ee;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
}
QHeaderView::section:horizontal { border-right: 1px solid #eef1f5; }
QTableCornerButton::section { background-color: #f7f9fb; border: none; border-bottom: 1px solid #e3e8ee; }

/* ── Menus / nav ────────────────────────────────────────────────────────── */
QMenuBar { background-color: #ffffff; border-bottom: 1px solid #e3e8ee; }
QMenuBar::item { padding: 5px 10px; background: transparent; color: #64748b; }
QMenuBar::item:selected { background-color: #eef2f7; color: #0f172a; }
QMenu { background-color: #ffffff; border: 1px solid #e3e8ee; border-radius: 8px; padding: 6px; }
QMenu::item { padding: 6px 14px; border-radius: 6px; color: #0f172a; }
QMenu::item:selected { background-color: #e6f6f4; color: #0d9488; }
QMenu::item:disabled { color: #94a3b8; }
QMenu::separator { height: 1px; background: #e3e8ee; margin: 5px 6px; }

/* ── Top navigation (QToolBar of checkable QActions) ────────────────────── */
QToolBar {
    background-color: #ffffff;
    border: none;
    border-bottom: 1px solid #e3e8ee;
    padding: 5px 9px;
    spacing: 4px;
}
QToolBar QToolButton {
    background: transparent;
    color: #64748b;
    border: none;
    border-radius: 8px;
    padding: 6px 11px;
    font-size: 12px;
    font-weight: 600;
}
QToolBar QToolButton:hover { background-color: #eef2f7; color: #0f172a; }
QToolBar QToolButton:checked { background-color: #e6f6f4; color: #0d9488; }
QLabel#brand { color: #0d9488; font-size: 15px; font-weight: 800; padding: 0 6px; }
QLabel#userbox { color: #64748b; font-size: 11px; font-weight: 600; }

/* Invalid form field (set property error=true). */
QLineEdit[error="true"], QPlainTextEdit[error="true"], QComboBox[error="true"] {
    border: 1px solid #e02424;
}

/* ── Tabs ───────────────────────────────────────────────────────────────── */
QTabWidget::pane { border: 1px solid #e3e8ee; border-radius: 10px; top: -1px; background: #ffffff; }
QTabBar::tab {
    background: transparent;
    color: #64748b;
    padding: 6px 13px;
    margin-right: 2px;
    border: none;
    border-bottom: 2px solid transparent;
    font-weight: 600;
}
QTabBar::tab:hover { color: #0f172a; }
QTabBar::tab:selected { color: #0d9488; border-bottom: 2px solid #0d9488; }

/* ── Combo box ──────────────────────────────────────────────────────────── */
QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView {
    background: #ffffff; border: 1px solid #e3e8ee; border-radius: 8px;
    selection-background-color: #e6f6f4; selection-color: #0d9488; outline: none;
    padding: 4px;
}
QComboBox QAbstractItemView::item { padding: 5px 8px; border-radius: 6px; min-height: 20px; }

/* ── Tooltip ────────────────────────────────────────────────────────────── */
QToolTip {
    background-color: #0f172a; color: #ffffff; border: 1px solid #0f172a;
    border-radius: 6px; padding: 4px 8px;
}

/* ── Status bar ─────────────────────────────────────────────────────────── */
QStatusBar { background-color: #ffffff; color: #64748b; border-top: 1px solid #e3e8ee; }

/* ── Scrollbars ─────────────────────────────────────────────────────────── */
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #d3dbe4; border-radius: 5px; min-height: 28px; margin: 2px; }
QScrollBar::handle:vertical:hover { background: #bcc7d4; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; }
QScrollBar::handle:horizontal { background: #d3dbe4; border-radius: 5px; min-width: 28px; margin: 2px; }
QScrollBar::handle:horizontal:hover { background: #bcc7d4; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }

/* Inventory dropdown: hide the native menu arrow (the chevron is in the label). */
QToolBar QToolButton::menu-indicator { image: none; width: 0px; height: 0px; }
